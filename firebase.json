{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "firestore.rules", "firestore.indexes.json", "FIREBASE-SETUP.md", "INICIAR-PEP.bat", "servidor.ps1", "**/node_modules/**", "**/.*"],
    "cleanUrls": true,
    "headers": [{ "source": "**/*.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
